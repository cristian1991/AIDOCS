from aidocs_mcp.intent_grant_detector import detect_grant, _clear_alias_pos_cache, _LEMMASETS_BY_LANG
_LEMMASETS_BY_LANG.clear()
_clear_alias_pos_cache()
cases = [
    ("after the commit, push to main", "git_ops"),
    ("let me edit this", "[] first-person en"),
    ("i want to edit this file", "[] first-person en"),
    ("i want you to refactor the page", "ai_slop (you=agent)"),
    ("please edit the config", "ai_replace + edit"),
    ("refactor the duplicate code", "ai_slop"),
    ("the edit was approved", "ai_review only"),
    # Cross-lang — only DET-POS check works when per-lang model loaded
    ("refactor il codice duplicato", "ai_slop (it)"),
    ("refactor das duplikat", "ai_slop (de)"),
]
for prompt, want in cases:
    r = detect_grant(prompt)
    sup = [x for x in r.reasons if "suppress" in x]
    print("PROMPT:", prompt, "WANT:", want, "LANG:", r.language)
    print("  granted:", sorted(r.granted_tools))
    if sup: print("  suppressed:", sup)

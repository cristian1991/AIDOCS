"""One-shot POS filter smoke. Delete after verification."""
from aidocs_mcp.intent_grant_detector import detect_grant, _clear_alias_pos_cache

_clear_alias_pos_cache()
cases = [
    ("the edit was approved", "no ai_replace/edit"),
    ("edit the config file", "ai_replace + edit"),
    ("grep the logs for error", "grep"),
    ("extract text from the pdf report", "ai_read_pdf"),
    ("begin a new task for this work", "ai_task"),
    ("I usually read the logs daily", "read"),
    ("commit and push to main", "git_commit_and_push"),
]
for prompt, want in cases:
    r = detect_grant(prompt)
    sup = [x for x in r.reasons if "suppress" in x]
    print("PROMPT:", prompt, "WANT:", want)
    print("  granted:", sorted(r.granted_tools))
    if sup:
        print("  suppressed:", sup)

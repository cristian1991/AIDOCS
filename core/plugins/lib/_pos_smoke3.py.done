from aidocs_mcp.intent_grant_detector import detect_grant, _clear_alias_pos_cache
from aidocs_mcp.aidocs_nlp.service import get_service
from pathlib import Path

svc = get_service(Path.cwd(), {})
_clear_alias_pos_cache()

cases = [
    "i want you to refactor the page",
    "edit the page before push",
    "edit the page before deploy",
    "please refactor the duplicate code",
    "could you grep the logs?",
    "after the commit, push to main",
    "the refactor was approved",       # noun usage
    "the edit happened yesterday",     # noun usage
    "let me edit this",                # first-person, should still surface (no DET before edit)
]
for prompt in cases:
    doc = svc.analyze(prompt, language="en")
    print("PROMPT:", prompt)
    if doc:
        print("  parse:", [(t.text, t.pos, t.dep) for t in doc.tokens])
    r = detect_grant(prompt)
    sup = [x for x in r.reasons if "suppress" in x]
    print("  granted:", sorted(r.granted_tools))
    if sup: print("  suppressed:", sup)
    print()

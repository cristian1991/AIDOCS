# Project memory IS tracked in the private repo — it's the migration
# payload between conductors across machines / branches. The public sync
# step (sync-to-public.yml) strips /.MEMORY/ before publishing, so the
# public repo never sees project memory.
#
# Ignored anyway:
#   /.MEMORY/.index/ — derived index (rebuildable, noisy diffs).
#   **/.MEMORY/ except /.MEMORY/ — stray dirs created by the MCP server
#     when launched with CWD inside a subpackage. Only the project-root
#     .MEMORY/ is canonical.
/.MEMORY/.index/
/**/.MEMORY/
!/.MEMORY/
# Host-local overrides (not committed). The tracked /AGENTS.md and
# /CLAUDE.md at project root are minimal routers pointing at
# /.MEMORY/.aidocs/index.aidocs — those ARE tracked. Only opencode.jsonc
# stays host-local.
/opencode.jsonc

# OpenCode runtime
.opencode/node_modules/
.opencode/bun.lock
.opencode/package.json
.opencode/plugins/

# Dashboard demo
/demodash/

# Claude Code local settings + ScheduleWakeup task locks
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
# pytest basetemp — repo-scoped to avoid %Temp% contention with Defender
mcp/.pytest-tmp/
.pytest-tmp/

# Per-worker global config DB created by mcp/tests/conftest.py
# pytest_configure hook to isolate xdist workers from each other and
# from the developer's real ~/.aidocs/config.sqlite3.
.pytest-aidocs-global-config/

# Pytest scratch dirs from poisoner-bisect / loop / confirm runs.
# These are operator-side debugging artifacts and never belong in
# the repo. Pattern catches all common one-off basetemp names.
.pytest-pair*/
.pytest-bisect*/
.pytest-confirm*/
.pytest-reverse/
.pytest-guilty/
.pytest-sec012/
.pytest-loop-*/
.pytest-file/
.pytest-filtered/
.pytest-xdist-*/
.pytest-debug/
.pytest-full-conductor/

# Derived indexes (rebuildable)
core/.MEMORY/.index/

# Build artifacts
mcp/build/
mcp/dist/
.mcp.json

# Dashboard generated files
apps/aidocs-dashboard/node_modules/
apps/aidocs-dashboard/src-tauri/target/
# Vite build output — rebuilt by `npm run build` / `npm run tauri build`.
# Release bundling ships the built binary (~/.aidocs/aidocs-dashboard.exe),
# not this intermediate dist tree. Keeping it in git produced churn on every
# rebuild without adding value.
apps/aidocs-dashboard/dist/

# Per-session ephemeral gate state. Rewritten by the gate every time it
# makes a decision; not meaningful history.
/.MEMORY/sessions/*/query-gate.json

# ai_run detached-command artifacts (cmd / log / status triplets).
# Logs should be auto-deleted post ai_run_output read; until that lands,
# don't ship them. Pure runtime state.
/.MEMORY/.runs/

# Local git worktrees
.worktrees/
.playwright-mcp/
overlay-*.png
.playwright-mcp/

# Big-boss per-project index DBs — runtime state, rebuilt on demand.
# Post-Beat-3 the machine-owned project config lives here; committing it
# would leak per-operator usage data AND trigger the config-write guard
# on every stage operation.
.MEMORY/.index/
**/.MEMORY/.index/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# sovereign soul exports — never track (privacy: souls are not the king's to read/audit)
.tmp/head-conductor-source.json
.tmp/head-conductor-content.md
.tmp/restore-*.md
.tmp/restore_empire_skills.py

# ── Local proof-script / scratch directory (2026-05-27) ─────────────
# /.tmp/ at repo root holds one-shot probe scripts, intermediate
# JSON dumps, manual commit-message drafts, edit-block snapshots,
# etc. They're operator-side debugging artifacts and must never
# end up in commits (they bloat the diff with hundreds of files
# and may carry test-only credentials). The narrower per-file rules
# above are retained for the specific privacy carve-outs that
# pre-dated this blanket rule.
/.tmp/

# Root-level scratch files produced by ad-hoc probe scripts.
# `git add -A` would otherwise pick these up alongside intended edits.
/scratch_*.py
/_old_*.txt
/_new_*.txt
/_patch_*.py
/_transport_*.txt

# AIDOCS runtime state under /.MEMORY/ that should NEVER be committed.
# These are gate-side mutations from every tool call — committing
# them produces enormous diffs full of audit / checkpoint / log noise.
# Project memory (sessions, plans, journal) IS tracked; these
# specifically-runtime subdirs are not.
/.MEMORY/.checkpoints/
/.MEMORY/.runtime/
**/.MEMORY/.checkpoints/
**/.MEMORY/.runtime/

# Session archive (re-generated when sessions are archived; never
# part of an intended code commit).
/.MEMORY/archive/

# Crown-gate report artifacts (regenerated by core/scripts/crown_gate.py)
scratch/reports/

# Signed-release artifacts: the per-release manifest + detached signature are
# generated at build/deploy time by scripts/build_signed_release.py and go
# stale on the next source edit, so they are NOT committed. The pinned PUBLIC
# key IS committed (it is the root-of-trust anchor); the PRIVATE key lives
# outside the repo entirely.
mcp/server/aidocs_mcp/trust/release_manifest.json
mcp/server/aidocs_mcp/trust/release_manifest.json.sig

# pytest-cov + pytest-json-report artifacts (deploy-gate-generated, not source)
.coverage
scratch/reports/

# ── Runtime state that must never be tracked (2026-06-13 worktree green-up) ──
/.MEMORY/**/*.sqlite3
/.MEMORY/palace/
/.TRASH/
# Ad-hoc scratch probe / proof artifacts (kept on disk, not tracked)
/scratch/_*
/scratch/probe_*
/scratch/fs_triage.py
/scratch/codenexus-redesign-v3.zip
/_slop_clones_raw.json
/mcp/scripts/hook_speed_analyzer.py
